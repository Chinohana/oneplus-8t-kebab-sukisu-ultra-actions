diff --git a/kernel/selinux/sepolicy.c b/kernel/selinux/sepolicy.c
index 2934778..6d332c4 100644
--- a/kernel/selinux/sepolicy.c
+++ b/kernel/selinux/sepolicy.c
@@ -1109,13 +1109,14 @@ bool ksu_genfscon(struct policydb *db, const char *fs_name, const char *path, co
     return add_genfscon(db, fs_name, path, ctx);
 }
 
+#include "ss/services.h"
+
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
 #include "ss/avtab.h"
 #include "ss/constraint.h"
 #include "ss/ebitmap.h"
 #include "ss/hashtab.h"
 #include "ss/policydb.h"
-#include "ss/services.h"
 
 // ======== sepolicy ========
 
@@ -1198,4 +1199,96 @@ out_free_data:
 
     return ERR_PTR(ret);
 }
+#else
+void ksu_destroy_selinux_ss(struct selinux_ss *ss)
+{
+    if (!ss)
+        return;
+
+    if (ss->sidtab) {
+        sidtab_destroy(ss->sidtab);
+        kfree(ss->sidtab);
+    }
+    kfree(ss->map.mapping);
+    policydb_destroy(&ss->policydb);
+    kfree(ss);
+}
+
+struct selinux_ss *ksu_dup_selinux_ss(struct selinux_ss *old_ss)
+{
+    struct selinux_ss *new_ss;
+    struct policy_file fp;
+    struct selinux_mapping *map_copy = NULL;
+    void *data = NULL;
+    size_t len;
+    u32 latest_granting;
+    u16 map_size;
+    int ret;
+
+    if (!old_ss)
+        return ERR_PTR(-EINVAL);
+
+    len = old_ss->policydb.len;
+    data = vmalloc(len);
+    if (!data)
+        return ERR_PTR(-ENOMEM);
+
+    fp.data = data;
+    fp.len = len;
+    read_lock(&old_ss->policy_rwlock);
+    map_size = old_ss->map.size;
+    map_copy = kmemdup(old_ss->map.mapping,
+                       sizeof(*old_ss->map.mapping) * map_size,
+                       GFP_ATOMIC);
+    if (!map_copy)
+        ret = -ENOMEM;
+    else
+        ret = policydb_write(&old_ss->policydb, &fp);
+    latest_granting = old_ss->latest_granting;
+    read_unlock(&old_ss->policy_rwlock);
+    if (ret)
+        goto out_free_data;
+
+    new_ss = kzalloc(sizeof(*new_ss), GFP_KERNEL);
+    if (!new_ss) {
+        ret = -ENOMEM;
+        goto out_free_data;
+    }
+
+    fp.data = data;
+    fp.len = len;
+    ret = policydb_read(&new_ss->policydb, &fp);
+    if (ret)
+        goto out_free_ss;
+    new_ss->policydb.len = old_ss->policydb.len;
+
+    new_ss->sidtab = kzalloc(sizeof(*new_ss->sidtab), GFP_KERNEL);
+    if (!new_ss->sidtab) {
+        ret = -ENOMEM;
+        goto out_destroy_policydb;
+    }
+    ret = policydb_load_isids(&new_ss->policydb, new_ss->sidtab);
+    if (ret)
+        goto out_free_sidtab;
+
+    rwlock_init(&new_ss->policy_rwlock);
+    mutex_init(&new_ss->status_lock);
+    new_ss->latest_granting = latest_granting;
+    new_ss->map.size = map_size;
+    new_ss->map.mapping = map_copy;
+    kvfree(data);
+    return new_ss;
+
+out_free_sidtab:
+    kfree(new_ss->sidtab);
+    new_ss->sidtab = NULL;
+out_destroy_policydb:
+    policydb_destroy(&new_ss->policydb);
+out_free_ss:
+    kfree(new_ss);
+out_free_data:
+    kfree(map_copy);
+    kvfree(data);
+    return ERR_PTR(ret);
+}
 #endif
