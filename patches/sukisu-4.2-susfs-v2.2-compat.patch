diff --git a/fs/exec.c b/fs/exec.c
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1759,6 +1759,6 @@ static int __do_execve_file(int fd, struct filename *filename,
 #ifdef CONFIG_KSU
 #ifdef CONFIG_KSU_SUSFS
-	if (likely(susfs_is_current_proc_umounted()) ||
