ANDROID_NDK_VERSION=27.2.12479018

SUSFS_PATCH=patches/manual-hooks-susfs-v2.2-sm8250-4.19.patch
SUKISU_COMPAT_PATCH=patches/sukisu-builtin-b1-linux-4.19.patch
