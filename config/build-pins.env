KERNEL_REPOSITORY=https://github.com/LineageOS/android_kernel_oneplus_sm8250.git
KERNEL_BRANCH=lineage-23.2
KERNEL_PIN_PATH=pins/kernel-lineage-23.2
KERNEL_DEFCONFIG=vendor/kona-perf_defconfig
OPLUS_CONFIG=vendor/oplus.config

SUKISU_REPOSITORY=https://github.com/SukiSU-Ultra/SukiSU-Ultra
SUKISU_BRANCH=builtin
SUKISU_COMMIT=b1d534bc41941b2c818d7a1a1dac341e4aabfc2d
SUKISU_DRIVER_VERSION=40856

SUSFS_REPOSITORY=https://gitlab.com/simonpunk/susfs4ksu.git
